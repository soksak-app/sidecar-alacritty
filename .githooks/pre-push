#!/bin/sh
# Checks the commit messages that a push publishes before the push leaves this checkout; CI runs every other check. `make hooks` sets this folder as the git hook folder.
# git passes one line per pushed ref on stdin: `<local ref> <local sha> <remote ref> <remote sha>`; a new remote ref has the zero sha.
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # A new remote ref is checked from origin/main; the first push of a repository has no origin/main and checks every
  # commit of the pushed head.
  if [ "$remote_sha" != "$zero" ]; then range="$remote_sha..$local_sha"
  elif git rev-parse -q --verify origin/main >/dev/null; then range="origin/main..$local_sha"
  else range="$local_sha"; fi
  make -C "$root" push-check RANGE="$range" </dev/null || exit 1
done
